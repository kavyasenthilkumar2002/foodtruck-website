# EmailJS — https://www.emailjs.com/
#
# Public Key (Account → API keys) — required for contact form in the browser
# Private Key — server/Vercel only; add to EMAILJS_PRIVATE_KEY (never VITE_*)
#
# Template body should include: {{name}}, {{email}}, {{phone}}, {{message}}
# Settings → From Name: {{from_name}}  |  Reply-To: {{reply_to}}
#
VITE_EMAILJS_PUBLIC_KEY=your_public_key
VITE_EMAILJS_SERVICE_ID=service_d1715d5
VITE_EMAILJS_TEMPLATE_ID=template_yn4la69

EMAILJS_PUBLIC_KEY=your_public_key
EMAILJS_SERVICE_ID=service_d1715d5
EMAILJS_TEMPLATE_ID=template_yn4la69
EMAILJS_PRIVATE_KEY=your_private_key

